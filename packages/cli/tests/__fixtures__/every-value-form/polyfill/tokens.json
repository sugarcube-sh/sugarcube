{
  "color": {
    "$type": "color",
    "hex": {
      "rgb": {
        "$value": "#ff0000"
      },
      "rgba": {
        "$value": "#00000080"
      }
    },
    "oklch": {
      "with-hex": {
        "$value": {
          "colorSpace": "oklch",
          "components": [0.628, 0.2577, 29.23],
          "hex": "#ff0000"
        }
      },
      "with-hex-and-alpha": {
        "$value": {
          "colorSpace": "oklch",
          "components": [0.7016, 0.3225, 328.363],
          "alpha": 0.8,
          "hex": "#ff00ff"
        }
      }
    },
    "display-p3": {
      "with-hex": {
        "$value": {
          "colorSpace": "display-p3",
          "components": [0.9, 0.2, 0.1],
          "hex": "#e63946"
        }
      }
    },
    "srgb": {
      "basic": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.8, 0.4, 0.2]
        }
      },
      "with-hex": {
        "$value": {
          "colorSpace": "srgb",
          "components": [1, 0, 0],
          "hex": "#ff0000"
        }
      }
    },
    "hsl": {
      "basic": {
        "$value": {
          "colorSpace": "hsl",
          "components": [270, 80, 60]
        }
      }
    },
    "brand": {
      "$value": "{color.oklch.with-hex}"
    },
    "surface": {
      "$value": "#ffffff"
    }
  }
}
