{
  "color": {
    "$type": "color",
    "hex": {
      "rgb": {
        "$value": "#ff0000"
      },
      "rgba": {
        "$value": "#00000080"
      },
      "upper": {
        "$value": "#0000FF"
      }
    },
    "oklch": {
      "basic": {
        "$value": {
          "colorSpace": "oklch",
          "components": [0.7016, 0.3225, 328.363]
        }
      },
      "with-alpha": {
        "$value": {
          "colorSpace": "oklch",
          "components": [0.62796, 0.25768, 29.2338],
          "alpha": 0.8
        }
      },
      "with-none": {
        "$value": {
          "colorSpace": "oklch",
          "components": [0.7, "none", 90]
        }
      },
      "with-hex": {
        "$value": {
          "colorSpace": "oklch",
          "components": [0.628, 0.2577, 29.23],
          "hex": "#ff0000"
        }
      }
    },
    "display-p3": {
      "basic": {
        "$value": {
          "colorSpace": "display-p3",
          "components": [0.9, 0.2, 0.1]
        }
      },
      "with-hex": {
        "$value": {
          "colorSpace": "display-p3",
          "components": [0.9, 0.2, 0.1],
          "hex": "#e63946"
        }
      },
      "with-alpha": {
        "$value": {
          "colorSpace": "display-p3",
          "components": [0.1, 0.6, 0.9],
          "alpha": 0.5
        }
      }
    },
    "srgb": {
      "basic": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.8, 0.4, 0.2]
        }
      },
      "with-alpha": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.2, 0.4, 0.8],
          "alpha": 0.9
        }
      },
      "with-hex": {
        "$value": {
          "colorSpace": "srgb",
          "components": [1, 0, 0],
          "hex": "#ff0000"
        }
      },
      "with-hex-and-alpha": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0, 0, 1],
          "alpha": 0.5,
          "hex": "#0000ff"
        }
      }
    },
    "hsl": {
      "basic": {
        "$value": {
          "colorSpace": "hsl",
          "components": [270, 80, 60]
        }
      },
      "with-none": {
        "$value": {
          "colorSpace": "hsl",
          "components": ["none", 50, 70]
        }
      }
    },
    "brand": {
      "$value": "{color.oklch.basic}"
    },
    "surface": {
      "$value": "#ffffff"
    },
    "text": {
      "$value": "#111111"
    },
    "on-brand": {
      "$value": "{color.surface}"
    }
  },
  "space": {
    "$type": "dimension",
    "zero": {
      "$value": {
        "value": 0,
        "unit": "px"
      }
    },
    "small": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "medium": {
      "$value": {
        "value": 1,
        "unit": "rem"
      }
    },
    "fine": {
      "$value": {
        "value": 0.125,
        "unit": "rem"
      }
    },
    "reference": {
      "$value": "{space.small}"
    },
    "fluid": {
      "$value": {
        "value": 2,
        "unit": "rem"
      },
      "$extensions": {
        "sh.sugarcube": {
          "fluid": {
            "min": {
              "value": 1,
              "unit": "rem"
            },
            "max": {
              "value": 2,
              "unit": "rem"
            }
          }
        }
      }
    },
    "fluid-px": {
      "$value": {
        "value": 48,
        "unit": "px"
      },
      "$extensions": {
        "sh.sugarcube": {
          "fluid": {
            "min": {
              "value": 24,
              "unit": "px"
            },
            "max": {
              "value": 48,
              "unit": "px"
            }
          }
        }
      }
    }
  },
  "duration": {
    "$type": "duration",
    "fast": {
      "$value": {
        "value": 300,
        "unit": "ms"
      }
    },
    "slow": {
      "$value": {
        "value": 1.5,
        "unit": "s"
      }
    },
    "reference": {
      "$value": "{duration.fast}"
    }
  },
  "easing": {
    "$type": "cubicBezier",
    "linear": {
      "$value": [0, 0, 1, 1]
    },
    "ease-in": {
      "$value": [0.42, 0, 1, 1]
    },
    "ease-out": {
      "$value": [0, 0, 0.58, 1]
    },
    "reference": {
      "$value": "{easing.ease-in}"
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "single": {
        "$value": "Arial"
      },
      "spaced": {
        "$value": "Helvetica Neue"
      },
      "stack": {
        "$value": ["Helvetica Neue", "Arial", "sans-serif"]
      },
      "reference": {
        "$value": "{font.family.stack}"
      }
    },
    "weight": {
      "$type": "fontWeight",
      "thin": {
        "$value": 100
      },
      "normal": {
        "$value": 400
      },
      "bold": {
        "$value": 700
      },
      "keyword-thin": {
        "$value": "thin"
      },
      "keyword-normal": {
        "$value": "normal"
      },
      "keyword-bold": {
        "$value": "bold"
      },
      "reference": {
        "$value": "{font.weight.bold}"
      }
    }
  },
  "number": {
    "$type": "number",
    "zero": {
      "$value": 0
    },
    "line-height": {
      "$value": 1.5
    },
    "integer": {
      "$value": 3
    },
    "reference": {
      "$value": "{number.line-height}"
    }
  },
  "stroke": {
    "$type": "strokeStyle",
    "solid": {
      "$value": "solid"
    },
    "dashed": {
      "$value": "dashed"
    },
    "dash-single": {
      "$value": {
        "dashArray": [
          {
            "value": 4,
            "unit": "px"
          }
        ],
        "lineCap": "round"
      }
    },
    "dash-multiple": {
      "$value": {
        "dashArray": [
          {
            "value": 4,
            "unit": "px"
          },
          {
            "value": 2,
            "unit": "px"
          }
        ],
        "lineCap": "butt"
      }
    }
  },
  "border": {
    "$type": "border",
    "thin": {
      "$value": {
        "color": "#000000",
        "width": {
          "value": 1,
          "unit": "px"
        },
        "style": "solid"
      }
    },
    "thick": {
      "$value": {
        "color": "#0000FF80",
        "width": {
          "value": 4,
          "unit": "px"
        },
        "style": "dashed"
      }
    },
    "custom": {
      "$value": {
        "color": "#FF0000",
        "width": {
          "value": 2,
          "unit": "px"
        },
        "style": {
          "dashArray": [
            {
              "value": 4,
              "unit": "px"
            },
            {
              "value": 2,
              "unit": "px"
            }
          ],
          "lineCap": "round"
        }
      }
    },
    "referenced": {
      "$value": {
        "color": "{color.brand}",
        "width": "{space.small}",
        "style": "{stroke.dashed}"
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "basic": {
      "$value": {
        "color": "#000000",
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 2,
          "unit": "px"
        },
        "blur": {
          "value": 4,
          "unit": "px"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        }
      }
    },
    "inset": {
      "$value": {
        "color": "#000000",
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 2,
          "unit": "px"
        },
        "blur": {
          "value": 4,
          "unit": "px"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        },
        "inset": true
      }
    },
    "multiple": {
      "$value": [
        {
          "color": "#000000",
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 2,
            "unit": "px"
          },
          "blur": {
            "value": 4,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        },
        {
          "color": "#0000FF",
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 4,
            "unit": "px"
          },
          "blur": {
            "value": 8,
            "unit": "px"
          },
          "spread": {
            "value": 2,
            "unit": "px"
          },
          "inset": true
        }
      ]
    },
    "referenced": {
      "$value": {
        "color": "{color.text}",
        "offsetX": "{space.zero}",
        "offsetY": "{space.small}",
        "blur": "{space.small}",
        "spread": {
          "value": 0,
          "unit": "px"
        }
      }
    },
    "reference": {
      "$value": "{shadow.basic}"
    }
  },
  "gradient": {
    "$type": "gradient",
    "simple": {
      "$value": [
        {
          "color": "#000000",
          "position": 0
        },
        {
          "color": "#ffffff",
          "position": 1
        }
      ]
    },
    "multiple": {
      "$value": [
        {
          "color": "#000000",
          "position": 0
        },
        {
          "color": "#666666",
          "position": 0.5
        },
        {
          "color": "#ffffff",
          "position": 1
        }
      ]
    },
    "out-of-range": {
      "$value": [
        {
          "color": "#000000",
          "position": -99
        },
        {
          "color": "#888888",
          "position": 1.5
        },
        {
          "color": "#ffffff",
          "position": 42
        }
      ]
    },
    "referenced": {
      "$value": [
        {
          "color": "{color.brand}",
          "position": 0
        },
        {
          "color": "{color.srgb.basic}",
          "position": 1
        }
      ]
    }
  },
  "transition": {
    "$type": "transition",
    "basic": {
      "$value": {
        "duration": {
          "value": 200,
          "unit": "ms"
        },
        "delay": {
          "value": 0,
          "unit": "ms"
        },
        "timingFunction": [0.42, 0, 0.58, 1]
      }
    },
    "referenced": {
      "$value": {
        "duration": "{duration.fast}",
        "delay": "{duration.slow}",
        "timingFunction": "{easing.ease-out}"
      }
    }
  },
  "typography": {
    "$type": "typography",
    "partial": {
      "$value": {
        "fontFamily": "Arial, sans-serif",
        "fontSize": {
          "value": 16,
          "unit": "px"
        }
      }
    },
    "complete": {
      "$value": {
        "fontFamily": ["Arial", "sans-serif"],
        "fontSize": {
          "value": 16,
          "unit": "px"
        },
        "fontWeight": 400,
        "lineHeight": 1.5,
        "letterSpacing": {
          "value": 0.5,
          "unit": "px"
        }
      }
    },
    "referenced": {
      "$value": {
        "fontFamily": "{font.family.stack}",
        "fontSize": "{space.medium}",
        "fontWeight": "{font.weight.keyword-bold}",
        "lineHeight": "{number.line-height}",
        "letterSpacing": "{space.zero}"
      }
    }
  }
}
