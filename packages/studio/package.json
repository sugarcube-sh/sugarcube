{
  "name": "@sugarcube-sh/studio",
  "version": "0.0.1",
  "private": true,
  "description": "Visual design system editor for sugarcube",
  "license": "MIT",
  "author": {
    "name": "Mark Tomlinson",
    "email": "mark@marktomlinson.dev",
    "url": "https://marktomlinson.dev"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./client": {
      "types": "./dist/client.d.mts",
      "import": "./dist/client.mjs"
    }
  },
  "scripts": {
    "build": "pkgroll --minify && pnpm run build:client",
    "build:client": "vite build",
    "dev": "vite",
    "dev:dist": "pnpm run \"/^dev:(lib|client)$/\"",
    "dev:lib": "pkgroll --watch",
    "dev:client": "vite build --watch --mode development",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-slider": "^1.4.7",
    "@sugarcube-sh/core": "workspace:*",
    "@sugarcube-sh/studio-protocol": "workspace:*"
  },
  "devDependencies": {
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-tabs": "^1.1.21",
    "@sugarcube-sh/cli": "workspace:*",
    "@sugarcube-sh/vite": "workspace:*",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@unocss/preset-wind3": "^66.6.0",
    "@vitejs/devtools-kit": "^0.1.13",
    "@vitejs/plugin-react": "^6.0.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.468.0",
    "pkgroll": "^2.26.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.8.3",
    "vite": "^8.0.3",
    "zustand": "^5.0.15"
  }
}
