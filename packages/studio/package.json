{
  "name": "@sugarcube-sh/studio",
  "version": "0.0.1",
  "private": true,
  "description": "Visual design system editor for sugarcube",
  "license": "UNLICENSED",
  "author": {
    "name": "Mark Tomlinson",
    "email": "mark@marktomlinson.dev",
    "url": "https://marktomlinson.dev"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./client": {
      "types": "./dist/client.d.mts",
      "import": "./dist/client.mjs"
    },
    "./server": {
      "types": "./dist/server.d.mts",
      "import": "./dist/server.mjs"
    },
    "./write-ops": {
      "types": "./dist/write-ops.d.mts",
      "import": "./dist/write-ops.mjs"
    }
  },
  "scripts": {
    "build": "pkgroll --minify && pnpm run build:client && pnpm run build:page-script",
    "build:client": "vite build",
    "dev": "vite",
    "dev:dist": "pnpm run \"/^dev:(lib|client)$/\"",
    "dev:lib": "pkgroll --watch",
    "dev:client": "vite build --watch --mode development",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "build:page-script": "vite build --config vite.page-script.config.ts"
  },
  "dependencies": {
    "@sugarcube-sh/core": "workspace:*",
    "culori": "^4.0.2",
    "devframe": "^1.0.0",
    "hdr-color-input": "0.4.2",
    "jsonc-parser": "^3.3.1",
    "radix-ui": "^1.6.7"
  },
  "devDependencies": {
    "@sugarcube-sh/cli": "workspace:*",
    "@sugarcube-sh/vite": "workspace:*",
    "@types/culori": "^4.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@unocss/preset-wind3": "^66.10.5",
    "@vitejs/plugin-react": "^6.1.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.41.0",
    "pkgroll": "^2.28.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.9.6",
    "typescript": "^5.8.3",
    "vite": "^8",
    "zustand": "^5.0.15",
    "@devframes/vite": "^1.0.0"
  }
}
