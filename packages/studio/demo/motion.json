{
  "motion": {
    "$description": "Timing. Present mostly so the renderer has to handle a type that is neither a colour nor a dimension.",
    "duration": {
      "$type": "duration",
      "fast": { "$value": { "value": 100, "unit": "ms" } },
      "normal": { "$value": { "value": 200, "unit": "ms" } },
      "slow": { "$value": { "value": 400, "unit": "ms" } }
    },
    "ease": {
      "$type": "cubicBezier",
      "out": { "$value": [0.16, 1, 0.3, 1] },
      "in": { "$value": [0.7, 0, 0.84, 0] }
    },
    "transition": {
      "$type": "transition",
      "$description": "A composite folding a duration, an optional delay and a curve into one token.",
      "default": {
        "$value": {
          "duration": "{motion.duration.normal}",
          "delay": { "value": 0, "unit": "ms" },
          "timingFunction": "{motion.ease.out}"
        }
      },
      "slow": {
        "$description": "Literal sub-values rather than references. All three sub-values are required by the spec, delay included.",
        "$value": {
          "duration": { "value": 400, "unit": "ms" },
          "delay": { "value": 50, "unit": "ms" },
          "timingFunction": [0.42, 0, 0.58, 1]
        }
      }
    }
  }
}
