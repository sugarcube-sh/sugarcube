{
  "color": {
    "$type": "color",
    "ink": { "$value": { "colorSpace": "srgb", "components": [0, 0, 0] } }
  },
  "space": { "$type": "dimension", "sm": { "$value": { "value": 2, "unit": "px" } } },
  "lifted": {
    "$type": "shadow",
    "$value": {
      "color": "{color.ink}",
      "offsetX": { "$ref": "#/space/sm/$value" },
      "offsetY": "{color.ink}",
      "blur": "{space.missing}",
      "spread": { "value": 0, "unit": "px" }
    }
  }
}
