{
  "ink": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0, 0, 0] } },
  "beyond": { "$type": "number", "$value": 2 },
  "before": { "$type": "number", "$value": -1 },
  "fade": {
    "$type": "gradient",
    "$value": [
      { "color": "{ink}", "position": 2 },
      { "color": "{ink}", "position": "{beyond}" },
      { "color": "{ink}", "position": { "$ref": "#/beyond/$value" } },
      { "color": "{ink}", "position": "{before}" }
    ]
  }
}
