{
  "brand": {
    "$type": "color",
    "$value": { "colorSpace": "oklch", "components": [0.7, 0.2, 20] }
  },
  "space": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
  "body": { "$type": "fontFamily", "$value": "Inter" },
  "heavy": { "$type": "fontWeight", "$value": "bold" },
  "line": { "$type": "strokeStyle", "$value": "solid" },
  "card": {
    "$type": "shadow",
    "$value": {
      "color": "{brand}",
      "offsetX": { "value": 0, "unit": "px" },
      "offsetY": { "value": 2, "unit": "px" },
      "blur": { "value": 4, "unit": "px" },
      "spread": { "value": 0, "unit": "px" }
    }
  },
  "fade": {
    "$type": "gradient",
    "$value": [
      { "color": "{brand}", "position": -1 },
      { "color": "{brand}", "position": 42 }
    ]
  },
  "text": {
    "$type": "typography",
    "$value": {
      "fontFamily": ["Inter", "sans-serif"],
      "fontSize": "{space}",
      "fontWeight": 400,
      "letterSpacing": { "value": 0, "unit": "px" },
      "lineHeight": 1.5
    }
  },
  "accent": { "$type": "color", "$value": "{brand}" }
}
