{
  "button": {
    "$type": "number",
    "background": { "$value": 1 },
    "text": { "$value": 2 }
  },
  "base": { "$type": "number", "$value": 4 },
  "alias": { "$ref": "#/base/$value", "$type": "number", "$description": "Same as base" },
  "blue": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [0.2, 0.4, 0.9] }
  },
  "blue-red": { "$ref": "#/blue/$value/components/0", "$type": "number" },
  "untyped": { "$ref": "#/base/$value" },
  "stops-at-token": { "$ref": "#/base", "$type": "number" },
  "points-at-group": { "$ref": "#/button", "$type": "number" },
  "copies-a-group": { "$ref": "#/button", "background": { "$value": 9 } },
  "both": { "$ref": "#/base/$value", "$value": 5, "$type": "number" },
  "nowhere": { "$ref": "#/no/such/thing", "$type": "number" },
  "elsewhere": { "$ref": "other.json#/base/$value", "$type": "number" },
  "wrong-json": { "$ref": 5 }
}
