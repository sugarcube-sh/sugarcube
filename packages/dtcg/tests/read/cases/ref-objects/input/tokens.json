{
  "button": {
    "$type": "number",
    "background": { "$value": 1 },
    "text": { "$value": 2 }
  },
  "button-primary": {
    "$ref": "#/button",
    "background": { "$value": 9 }
  },
  "base": { "$type": "number", "$value": 4 },
  "alias": { "$ref": "#/base", "$type": "number", "$description": "Same as base" },
  "blue": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [0.2, 0.4, 0.9] }
  },
  "blue-red": { "$ref": "#/blue/$value/components/0", "$type": "number" },
  "untyped": { "$ref": "#/base" },
  "nowhere": { "$ref": "#/no/such/thing" },
  "elsewhere": { "$ref": "other.json#/base" },
  "wrong-json": { "$ref": 5 },
  "crowded": { "$ref": "#/base", "$type": "number", "extra": { "$value": 1 } }
}
