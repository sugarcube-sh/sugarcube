{
  "entry": "tokens.json",
  "spec": "the safe fixes for a bad value, each of which keeps what the value means: a string with an allowed unit becomes the object, a three-digit hex gets six digits, and a reference inside a value becomes a JSON Pointer to the same token's value. A string whose unit is not allowed gets no fix. Each is at the part it concerns, nested or not",
  "diagnostics": [
    {
      "kind": "invalid-value",
      "detail": { "at": ["$value"], "type": "dimension", "reason": "string-with-unit", "value": "16px" },
      "at": { "file": "tokens.json", "text": "\"16px\"" },
      "path": "space",
      "fixes": [
        {
          "title": "write the dimension as an object",
          "safe": true,
          "edits": [
            {
              "file": "tokens.json",
              "text": "\"16px\"",
              "replaceWith": "{ \"value\": 16, \"unit\": \"px\" }"
            }
          ]
        }
      ]
    },
    {
      "kind": "invalid-value",
      "detail": { "at": ["$value"], "type": "dimension", "reason": "string-with-unit", "value": "16em" },
      "at": { "file": "tokens.json", "text": "\"16em\"" },
      "path": "wide"
    },
    {
      "kind": "invalid-value",
      "detail": { "at": ["$value"], "type": "duration", "reason": "string-with-unit", "value": "200ms" },
      "at": { "file": "tokens.json", "text": "\"200ms\"" },
      "path": "fast",
      "fixes": [
        {
          "title": "write the duration as an object",
          "safe": true,
          "edits": [
            {
              "file": "tokens.json",
              "text": "\"200ms\"",
              "replaceWith": "{ \"value\": 200, \"unit\": \"ms\" }"
            }
          ]
        }
      ]
    },
    {
      "kind": "invalid-value",
      "detail": {
        "at": ["$value", 0],
        "type": "fontFamily",
        "reason": "alias-not-allowed-here",
        "reference": "{font.brand}"
      },
      "at": { "file": "tokens.json", "text": "\"{font.brand}\"" },
      "path": "font.body",
      "fixes": [
        {
          "title": "write it as the pointer `#/font/brand/$value`, which can stand for part of a value",
          "safe": true,
          "edits": [
            {
              "file": "tokens.json",
              "text": "\"{font.brand}\"",
              "replaceWith": "{ \"$ref\": \"#/font/brand/$value\" }"
            }
          ]
        }
      ]
    },
    {
      "kind": "invalid-value",
      "detail": {
        "at": ["$value", "hex"],
