{
  "space": { "$type": "dimension", "$value": "16px" },
  "wide": { "$type": "dimension", "$value": "16em" },
  "fast": { "$type": "duration", "$value": "200ms" },
  "font": {
    "$type": "fontFamily",
    "brand": { "$value": "Inter" },
    "body": { "$value": ["{font.brand}", "serif"] }
  },
  "red": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [1, 0, 0], "hex": "#f00" }
  },
  "lift": {
    "$type": "shadow",
    "$value": {
      "color": { "colorSpace": "srgb", "components": [0, 0, 0], "hex": "#000" },
      "offsetX": "0px",
      "offsetY": { "value": 1, "unit": "px" },
      "blur": { "value": 2, "unit": "px" },
      "spread": { "value": 0, "unit": "px" }
    }
  }
}
