{
  "space": {
    "$type": "dimension",
    "$extensions": { "com.example": { "fluid": "yes" } },
    "sm": {
      "$value": { "value": 4, "unit": "px" },
      "$extensions": { "com.example": { "fluid": 1 } }
    },
    "md": {
      "$value": { "value": 8, "unit": "px" },
      "$extensions": { "com.example": { "fluid": true } }
    }
  },
  "gap": { "$value": "{space.md}", "$extensions": { "com.example": {} } },
  "brand": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [1, 0, 0] },
    "$extensions": { "com.example": { "fluid": "no" } }
  }
}
