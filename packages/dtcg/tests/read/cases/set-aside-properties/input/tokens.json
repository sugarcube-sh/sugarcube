{
  "space": { "$type": "dimension", "md": { "$value": { "value": 16, "unit": "px" } } },
  "heading": {
    "$type": "typography",
    "$value": {
      "fontFamily": "Inter",
      "fontSize": { "value": 2, "unit": "rem" },
      "fontWeight": 700,
      "letterSpacing": { "value": 0, "unit": "px" },
      "lineHeight": 1.2,
      "paragraphSpacing": { "$ref": "#/nowhere" },
      "textDecoration": "none"
    }
  },
  "card": {
    "$type": "border",
    "$value": {
      "color": { "colorSpace": "srgb", "components": [0, 0, 0] },
      "width": { "$ref": "#/space/md/$value" },
      "style": "solid",
      "radius": "{space.missing}"
    }
  }
}
