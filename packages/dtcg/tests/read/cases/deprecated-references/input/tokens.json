{
  "color": {
    "$type": "color",
    "blue": { "$value": { "colorSpace": "srgb", "components": [0.2, 0.4, 0.8] } },
    "old": {
      "$value": { "colorSpace": "srgb", "components": [0.2, 0.4, 0.8] },
      "$deprecated": "Use color.new"
    },
    "gone": {
      "$value": { "colorSpace": "srgb", "components": [0.2, 0.4, 0.8] },
      "$deprecated": true
    },
    "legacy": {
      "$deprecated": "Use color.new",
      "blue": { "$value": { "colorSpace": "srgb", "components": [0.2, 0.4, 0.8] } },
      "kept": {
        "$value": { "colorSpace": "srgb", "components": [0.2, 0.4, 0.8] },
        "$deprecated": false
      }
    },
    "self": {
      "$deprecated": true,
      "$value": {
        "colorSpace": "srgb",
        "components": [{ "$ref": "#/color/self/$value/components/1" }, 0.5, 0.5]
      }
    },
    "primary": { "$value": "{color.old}" },
    "secondary": { "$value": "{color.gone}" },
    "from-group": { "$value": "{color.legacy.blue}" },
    "from-kept": { "$value": "{color.legacy.kept}" },
    "tint": {
      "$value": {
        "colorSpace": "srgb",
        "components": [{ "$ref": "#/color/gone/$value/components/0" }, 0.5, 0.5]
      }
    },
    "fine": { "$value": "{color.blue}" }
  }
}
