{
  "entry": "tokens.json",
  "spec": "Format 8 and 9: a value that does not fit its type makes the token invalid (8: an appropriate error SHOULD be displayed). Each problem is its own diagnostic, at the part it concerns, or at the object where a missing part belongs, with the parser's code as reason and the facts to word it, and the type of the value that failed, which for a part is the part's. The token stays, without a value",
  "permutations": [
    {
      "tokens": [
        {
          "path": "red",
          "type": "color",
          "invalid": true,
          "authored": {
            "value": {
              "colorSpace": "srgb",
              "components": [2, 0, 0]
            },
            "typeDeclared": true
          }
        },
        {
          "path": "space",
          "invalid": true
        },
        {
          "path": "text",
          "invalid": true
        },
        {
          "path": "layers",
          "invalid": true
        }
      ]
    }
  ],
  "diagnostics": [
    {
      "kind": "invalid-value",
      "detail": {
