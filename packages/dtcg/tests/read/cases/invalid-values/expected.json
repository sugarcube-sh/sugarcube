        "unit": "em",
        "allowed": ["px", "rem"]
      },
      "at": {
        "file": "tokens.json",
        "text": "\"em\""
      },
      "path": "space"
    },
    {
      "kind": "invalid-value",
      "detail": {
        "type": "typography",
        "at": ["$value", "lineHeight"],
        "reason": "missing-property",
        "property": "lineHeight"
      },
      "at": {
        "file": "tokens.json",
        "valueAfter": "\"text\": {\n    \"$type\": \"typography\",\n    \"$value\":"
