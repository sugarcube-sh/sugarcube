      },
      "at": {
        "file": "tokens.json",
        "text": "\"8px\""
      },
      "path": "layers",
      "fixes": [
        {
          "title": "write the dimension as an object",
          "safe": true,
          "edits": [
            {
              "file": "tokens.json",
              "text": "\"8px\"",
              "replaceWith": "{ \"value\": 8, \"unit\": \"px\" }"
            }
          ]
        }
      ]
