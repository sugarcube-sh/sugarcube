{
  "brand-primary": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [0, 1, 0.4] }
  },
  "brand": {
    "secondary": {
      "$type": "color",
      "$value": { "colorSpace": "srgb", "components": [0.4, 0, 1] }
    }
  },
  "position-end": { "$type": "number", "$value": 1 },
  "brand-in-the-middle": {
    "$type": "gradient",
    "$value": [
      { "color": { "colorSpace": "srgb", "components": [0, 0, 0] }, "position": 0 },
      { "color": "{brand-primary}", "position": 0.5 },
      { "color": { "colorSpace": "srgb", "components": [0, 0, 0] }, "position": "{position-end}" }
    ]
  },
  "gradient-with-references": {
    "$type": "gradient",
    "$value": [
      "{gradient.start-stop}",
      { "color": "{brand.secondary}", "position": 0.333 },
      "{gradient.end-stop}"
    ]
  },
  "gradient": {
    "start-stop": {
      "$type": "gradient",
      "$value": [{ "color": { "colorSpace": "srgb", "components": [1, 1, 1] }, "position": 0 }]
    },
    "end-stop": {
      "$type": "gradient",
      "$value": [{ "color": { "colorSpace": "srgb", "components": [0, 0, 0] }, "position": 1 }]
    }
  }
}
