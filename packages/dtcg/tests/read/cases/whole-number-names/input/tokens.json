{
  "px": { "$type": "dimension", "$value": { "value": 1, "unit": "px" } },
  "2": { "$type": "dimension", "$value": { "value": 2, "unit": "px" } },
  "-1": { "$type": "dimension", "$value": { "value": -1, "unit": "px" } },
  "1": { "$type": "dimension", "$value": { "value": 1, "unit": "px" } },
  "space": {
    "$type": "dimension",
    "lg": { "$value": { "value": 16, "unit": "px" } },
    "10": { "$value": { "value": 40, "unit": "px" } },
    "2": { "$value": { "value": 8, "unit": "px" } }
  },
  "900": {
    "$type": "color",
    "ink": { "$value": { "colorSpace": "srgb", "components": [0, 0, 0] } }
  },
  "50": {
    "$type": "color",
    "ink": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1] } }
  }
}
