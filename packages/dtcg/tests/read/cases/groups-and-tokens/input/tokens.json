{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$metadata": { "tokenSetOrder": ["core"] },
  "$type": "number",
  "color": {
    "$type": "color",
    "$description": "Brand colors",
    "$extensions": { "com.example": { "tier": 1 } },
    "accent": {
      "$root": {
        "$value": { "colorSpace": "srgb", "components": [0.867, 0, 0] }
      },
      "light": {
        "$description": "Hover",
        "$deprecated": "use the root accent",
        "$extensions": { "com.example": { "note": true } },
        "$value": { "colorSpace": "srgb", "components": [1, 0.133, 0.133] }
      }
    }
  },
  "opacity": {
    "half": { "$value": 0.5 }
  },
  "space": {
    "sm": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } }
  }
}
