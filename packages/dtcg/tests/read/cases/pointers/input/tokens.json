{
  "base": {
    "blue": {
      "$type": "color",
      "$value": { "colorSpace": "srgb", "components": [0.2, 0.4, 0.9] }
    },
    "spacing": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
    "text": {
      "$type": "typography",
      "$value": {
        "fontFamily": ["Helvetica", "Arial", "sans-serif"],
        "fontSize": { "value": 16, "unit": "px" },
        "fontWeight": 400,
        "letterSpacing": { "value": 0, "unit": "px" },
        "lineHeight": 1.5
      }
    },
    "card": {
      "$type": "shadow",
      "$value": {
        "color": { "colorSpace": "srgb", "components": [0, 0, 0] },
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 2, "unit": "px" },
        "blur": { "value": 4, "unit": "px" },
        "spread": { "value": 0, "unit": "px" }
      }
    },
    "alias": { "$type": "color", "$value": "{base.blue}" }
  },
  "semantic": {
    "primary": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          { "$ref": "#/base/blue/$value/components/0" },
          { "$ref": "#/base/blue/$value/components/1" },
          0.7
        ]
      }
    },
    "small": {
      "$type": "dimension",
      "$value": { "value": { "$ref": "#/base/spacing/$value/value" }, "unit": "rem" }
    },
    "h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": { "$ref": "#/base/text/$value/fontFamily" },
        "fontSize": { "value": 32, "unit": "px" },
        "fontWeight": 700,
        "letterSpacing": { "value": 0, "unit": "px" },
        "lineHeight": { "$ref": "#/base/text/$value/lineHeight" }
      }
    },
    "whole": { "$value": { "$ref": "#/base/spacing" } },
    "shadow-color": { "$type": "color", "$value": { "$ref": "#/base/card/$value/color" } },
    "shadow-listed": { "$type": "color", "$value": { "$ref": "#/base/card/$value/0/color" } },
    "through-alias": {
      "$type": "number",
      "$value": { "$ref": "#/base/alias/$value/components/0" }
    },
    "wrong-type-part": {
      "$type": "border",
      "$value": {
        "color": { "$ref": "#/base/spacing" },
        "width": { "value": 1, "unit": "px" },
        "style": "solid"
      }
    },
    "wrong-type-whole": { "$type": "color", "$value": { "$ref": "#/base/spacing/$value" } },
    "wrong-kind": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [{ "$ref": "#/base/spacing/$value/unit" }, 0, 0]
      }
    }
  },
  "loop": {
    "$type": "number",
    "a": { "$value": { "$ref": "#/loop/b/$value" } },
    "b": { "$value": { "$ref": "#/loop/a/$value" } }
  }
}
