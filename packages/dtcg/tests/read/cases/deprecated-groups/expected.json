        },
        {
          "path": "old.b",
          "deprecated": "use new.b"
        },
        {
          "path": "old.kept.c",
          "deprecated": false
        },
        {
          "path": "old.kept.d",
          "deprecated": true
        }
      ],
      "groups": [
        {
          "path": "old",
          "deprecated": "use new"
        },
        {
          "path": "old.kept",
          "deprecated": false
        }
      ]
    }
  ],
