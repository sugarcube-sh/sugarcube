{
  "color": {
    "$type": "color",
    "plain": {
      "$value": { "colorSpace": "srgb", "components": [1, 0, 0] },
      "$extensions": { "com.example": {} }
    },
    "outlined": {
      "$value": { "colorSpace": "srgb", "components": [0, 0, 1] },
      "$extensions": { "com.example": { "outline": "2px" } }
    }
  }
}
