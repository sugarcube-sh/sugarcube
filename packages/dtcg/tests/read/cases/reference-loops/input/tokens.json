{
  "a": { "$type": "number", "$value": "{b}" },
  "b": { "$type": "number", "$value": "{c}" },
  "c": { "$type": "number", "$value": "{a}" },
  "d": { "$type": "number", "$value": "{a}" },
  "x": { "$type": "number", "$value": { "$ref": "#/y/$value/fontSize/value" } },
  "y": {
    "$type": "typography",
    "$value": {
      "fontFamily": "Inter",
      "fontSize": { "value": 16, "unit": "px" },
      "fontWeight": 400,
      "letterSpacing": { "value": 0, "unit": "px" },
      "lineHeight": "{x}"
    }
  }
}
