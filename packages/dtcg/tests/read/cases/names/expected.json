{
  "entry": "tokens.json",
  "spec": "Format 5.1.1: a name cannot start with $ or contain {, } or .; $root is a token name (6.2), so a $root with no $value is a group with a forbidden name, and $later, holding a token, is a name that starts with $. A space at either end is legal but warned about",
  "permutations": [
    {
      "tokens": [
        {
          "path": "size. e"
        },
        {
          "path": "size.g"
        }
      ],
      "groups": [
        { "path": "" },
        {
          "path": "size"
        }
      ]
    }
  ],
  "diagnostics": [
    {
      "kind": "invalid-name",
      "detail": {
        "name": "$later",
        "character": "$"
      },
      "span": {
        "file": "tokens.json",
        "text": "\"$later\""
      },
      "path": "size"
    },
    {
      "kind": "invalid-name",
      "detail": {
        "name": "a.b",
        "character": "."
      },
      "span": {
        "file": "tokens.json",
        "text": "\"a.b\""
      }
    },
    {
      "kind": "invalid-name",
      "detail": {
        "name": "{c}",
        "character": "{"
      },
      "span": {
        "file": "tokens.json",
        "text": "\"{c}\""
      }
    },
    {
      "kind": "invalid-name",
      "detail": {
        "name": "d}",
        "character": "}"
      },
      "span": {
        "file": "tokens.json",
        "text": "\"d}\""
      }
    },
    {
      "kind": "whitespace-in-name",
