        "text": "\" e\""
      }
    },
    {
      "kind": "invalid-name",
      "detail": {
        "name": "$root",
        "character": "$"
      },
      "span": {
        "file": "tokens.json",
        "text": "\"$root\""
      }
    }
  ]
