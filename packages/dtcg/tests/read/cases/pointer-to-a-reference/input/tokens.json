{
  "ink": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0, 0, 0] } },
  "card": {
    "$type": "border",
    "$value": { "color": "{ink}", "width": { "value": 1, "unit": "px" }, "style": "solid" }
  },
  "outline": {
    "$type": "border",
    "$value": {
      "color": { "$ref": "#/card/$value/color" },
      "width": { "value": 2, "unit": "px" },
      "style": "solid"
    }
  },
  "ring": { "$type": "number", "$value": { "$ref": "#/card/$value/color" } }
}
