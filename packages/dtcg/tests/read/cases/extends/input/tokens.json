{
  "button": {
    "$type": "number",
    "$description": "Buttons",
    "background": { "$value": 1 },
    "text": { "$value": 2 },
    "state": {
      "hover": { "$value": 3 },
      "focus": { "$value": 4 }
    }
  },
  "button-primary": {
    "$extends": "{button}",
    "background": { "$value": 9 },
    "state": {
      "hover": { "$value": 30 }
    }
  },
  "button-large": {
    "$extends": "{button-primary}",
    "padding": { "$value": 16 }
  }
}
