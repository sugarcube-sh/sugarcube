{
  "color": {
    "$type": "color",
    "red": { "$value": { "colorSpace": "srgb", "components": [1, 0, 0] } },
    "brand": { "$value": "{color.red}" }
  },
  "semantic": {
    "danger": { "$value": "{color.brand}" }
  },
  "space": { "$type": "dimension", "sm": { "$value": { "value": 1, "unit": "px" } } },
  "edge": {
    "$type": "border",
    "$value": { "color": "{semantic.danger}", "width": "{space.sm}", "style": "solid" }
  },
  "glow": {
    "$type": "shadow",
    "$value": {
      "color": "{color.brand}",
      "offsetX": "{space.sm}",
      "offsetY": { "value": 2, "unit": "px" },
      "blur": { "value": 4, "unit": "px" },
      "spread": { "value": 0, "unit": "px" }
    }
  }
}
