{
  "hue": {
    "$type": "color",
    "$value": { "colorSpace": "hsl", "components": [200, 50, 50] }
  },
  "tint": {
    "$type": "color",
    "$value": {
      "colorSpace": { "$ref": "#/hue/$value/colorSpace" },
      "components": [400, 50, 50]
    }
  },
  "shade": {
    "$type": "color",
    "$value": {
      "colorSpace": { "$ref": "#/hue/$value/colorSpace" },
      "components": [100, 50, 50]
    }
  }
}
