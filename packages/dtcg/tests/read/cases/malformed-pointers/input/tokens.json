{
  "color": {
    "$type": "color",
    "ink": { "$value": { "colorSpace": "srgb", "components": [0, 0, 0] } }
  },
  "a~b": { "$type": "number", "$value": 3 },
  "g": { "$type": "number", "one": { "$value": 1 } },
  "part": {
    "$type": "color",
    "$value": { "colorSpace": { "$ref": "#color/ink/$value/colorSpace" }, "components": [1, 0, 0] }
  },
  "whole": { "$description": "kept", "$ref": "#color/ink" },
  "tilde": { "$type": "number", "$value": { "$ref": "#/a~b/$value" } },
  "grouped": { "$ref": "#g" },
  "extending": { "$extends": { "$ref": "#g" } },
  "nowhere": { "$type": "number", "$value": { "$ref": "#missing/$value" } }
}
