{
  "color": {
    "$type": "color",
    "brand": { "$value": "#e11d48" },
    "loud": { "$value": "#E11D48" },
    "scrim": { "$value": "#00000080" },
    "white": { "$value": "#fff" },
    "veil": { "$value": "#0008" },
    "danger": { "$value": "{color.brand}" }
  },
  "edge": {
    "$type": "border",
    "$value": { "color": "#000000", "width": { "value": 1, "unit": "px" }, "style": "solid" }
  },
  "lift": {
    "$type": "shadow",
    "$value": {
      "color": "#00000080",
      "offsetX": { "value": 0, "unit": "px" },
      "offsetY": { "value": 2, "unit": "px" },
      "blur": { "value": 4, "unit": "px" },
      "spread": { "value": 0, "unit": "px" }
    }
  },
  "fade": {
    "$type": "gradient",
    "$value": [
      { "color": "#000000", "position": 0 },
      { "color": "#ffffff", "position": 1 }
    ]
  }
}
