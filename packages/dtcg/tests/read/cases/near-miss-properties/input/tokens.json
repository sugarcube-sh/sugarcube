{
  "color": {
    "$type": "color",
    "missing": { "value": { "colorSpace": "srgb", "components": [0, 0, 0] } },
    "swapped": { "$vlaue": { "colorSpace": "srgb", "components": [0, 0, 1] } },
    "capital": { "$Value": { "colorSpace": "srgb", "components": [0, 1, 0] } },
    "described": {
      "$value": { "colorSpace": "srgb", "components": [1, 0, 0] },
      "$descripton": "red"
    },
    "unknown": {
      "$value": { "colorSpace": "srgb", "components": [1, 1, 1] },
      "$whatever": 1
    },
    "named": { "value": { "$value": { "colorSpace": "srgb", "components": [0, 0, 0] } } },
    "text": { "$value": "{color.missing}" }
  },
  "space": {
    "type": "dimension",
    "sm": { "$value": { "value": 4, "unit": "px" } }
  }
}
