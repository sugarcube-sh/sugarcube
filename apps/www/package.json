{
  "name": "www",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "pnpm run build:registry && pnpm run build:api && cross-env REGISTRY_URL=/r astro build",
    "build:api": "tsx scripts/api-docs/generate.ts",
    "build:registry": "tsx scripts/build-registry.ts",
    "deploy": "pnpm run build && wrangler deploy",
    "dev": "pnpm run build:api && cross-env REGISTRY_URL=/r astro dev",
    "dev:debug": "cross-env DEBUG=sugarcube REGISTRY_URL=/r astro dev",
    "preview": "astro preview",
    "type-check": "astro sync && tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/react": "^6.0.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "3.7.5",
    "@astrojs/starlight": "^0.43.1",
    "@lucide/astro": "^1.41.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@sugarcube-sh/cli": "workspace:*",
    "@sugarcube-sh/core": "workspace:*",
    "@sugarcube-sh/vite": "workspace:*",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "astro": "^7.4.12",
    "astro-robots-txt": "^1.0.0",
    "astro-webmanifest": "^1.0.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cross-env": "^7.0.3",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "starlight-sidebar-topics": "^0.9.0",
    "ultrahtml": "^1.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@astrojs/markdown-satteri": "^0.4.10",
    "@unocss/preset-wind3": "^66.10.5",
    "@unocss/preset-wind4": "^66.10.5",
    "starlight-links-validator": "^0.27.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "wrangler": "^4.129.0"
  }
}
