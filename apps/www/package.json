{
  "name": "www",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "pnpm run build:registry && cross-env REGISTRY_URL=/r astro build",
    "build:registry": "tsx scripts/build-registry.ts",
    "deploy": "pnpm run build && wrangler deploy",
    "dev": "cross-env REGISTRY_URL=/r astro dev",
    "dev:debug": "cross-env DEBUG=true REGISTRY_URL=/r astro dev",
    "dev:studio": "cross-env SUGARCUBE_STUDIO=true REGISTRY_URL=/r astro dev",
    "preview": "astro preview",
    "type-check": "astro sync && tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/react": "^6.0.4",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "@astrojs/starlight": "^0.41.9",
    "@lucide/astro": "^0.562.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@sugarcube-sh/cli": "workspace:*",
    "@sugarcube-sh/core": "workspace:*",
    "@sugarcube-sh/studio": "workspace:*",
    "@sugarcube-sh/studio-embed": "workspace:*",
    "@sugarcube-sh/studio-vite": "workspace:*",
    "@sugarcube-sh/vite": "workspace:*",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "astro": "^7.2.9",
    "astro-robots-txt": "^1.0.0",
    "astro-webmanifest": "^1.0.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cross-env": "^7.0.3",
    "lucide-react": "^0.468.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "sirv": "^3.0.1",
    "ultrahtml": "^1.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@unocss/preset-wind3": "^66.6.0",
    "@unocss/preset-wind4": "^66.6.0",
    "@vitejs/devtools": "^0.1.13",
    "tsx": "^4.22.3",
    "wrangler": "^4.20.5"
  }
}
