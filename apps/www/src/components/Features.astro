---
import {
    Code,
    Layers,
    LayoutGrid,
    Package,
    Scaling,
    SunMoon,
} from "@lucide/astro";

const features = [
    {
        icon: Package,
        title: "Tokens as the source of truth",
        description:
            "Your design decisions live in portable, DTCG-standard JSON, not scattered across CSS. Analyse them, transform them, document them, take them anywhere.",
    },
    {
        icon: Code,
        title: "Real CSS, generated",
        description:
            "Variables and utility classes compiled straight from your tokens, just-in-time. You only ship the utilities you actually use.",
    },
    {
        icon: LayoutGrid,
        title: "Components you own",
        description:
            "Copy-in components, that land in your codebase as source files you're free to shape. React and CSS-only today, web components in progress.",
    },
    {
        icon: SunMoon,
        title: "Theming that scales",
        description:
            "Light, dark, high-contrast, multi-brand. Driven by modifiers, resolved to the exact selectors or media queries you want.",
    },
    {
        icon: Scaling,
        title: "Fluid by default",
        description:
            "Type and space that scale with the viewport via clamp(), generated from a scale you describe once.",
    },
] as const;

const stackLinks = [
    { label: "Vite", href: "/docs/vite" },
    { label: "Astro", href: "/docs/astro" },
    { label: "SvelteKit", href: "/docs/sveltekit" },
    { label: "Nuxt", href: "/docs/nuxt" },
    { label: "11ty", href: "/docs/11ty" },
    { label: "TanStack Start", href: "/docs/tanstack-start" },
] as const;
---

<section class="site-features region flow" aria-labelledby="features-heading">
    <h2 id="features-heading" class="homepage-section-heading site-features__heading">
        Features
    </h2>

    <div class="site-features__grid">
        {
            features.map((feature) => {
                const Icon = feature.icon;
                return (
                    <article class="site-features__card homepage-panel homepage-panel--interactive flow">
                        <Icon
                            class="site-features__icon"
                            aria-hidden="true"
                        />
                        <h3 class="site-features__title">{feature.title}</h3>
                        <p class="site-features__description">
                            {feature.description}
                        </p>
                    </article>
                );
            })
        }

        <article class="site-features__card homepage-panel homepage-panel--interactive flow">
            <Layers class="site-features__icon" aria-hidden="true" />
            <h3 class="site-features__title">Fits your stack</h3>
            <p class="site-features__description">
                First-class setup for{" "}
                {
                    stackLinks.map((link, index) => (
                        <span>
                            {index > 0 &&
                                (index === stackLinks.length - 1
                                    ? ", and "
                                    : ", ")}
                            <a href={link.href}>{link.label}</a>
                        </span>
                    ))
                }
                .
            </p>
        </article>
    </div>
</section>
