---
import CodeBlock from "@/src/components/CodeBlock.astro";
import { ArrowUpRight } from "@lucide/astro";
---

<section class="site-hero region region-space-xl">
    <div class="site-hero__grid">
        <div class="site-hero__content flow">
            <h1 class="site-hero__title text-pretty">
                Design system rigor, out of the box
            </h1>
            <div class="site-hero__body flow">
                <p>
                    Sugarcube turns design tokens into CSS variables, utilities,
                    and component styles.
                </p>
                <p>Change a token, everything updates.</p>
                <p>
                    Built on the <a
                        href="https://www.designtokens.org/"
                        target="_blank"
                        rel="noopener noreferrer">W3C DTCG token standard</a
                    >.
                </p>
            </div>
        </div>

        <div class="site-hero__aside flow">
            <p class="site-hero__aside-label text-quiet">
                Works with Vite or as a standalone CLI
            </p>
            <CodeBlock>
                <span class="text-quieter mr-3xs">$</span> pnpm dlx @sugarcube-sh/cli
                init</CodeBlock
            >
            <div class="cluster cluster-gap-2xs">
                <a
                    class="site-button"
                    data-variant="accent"
                    href="/docs/getting-started"
                    >Read the Docs <ArrowUpRight aria-hidden="true" /></a
                >
                <a
                    class="site-button"
                    href="/consulting"
                    data-appearance="outlined">Consulting</a
                >
            </div>
        </div>
    </div>
</section>
