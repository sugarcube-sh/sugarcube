---
import GetStartedAside from "@/src/components/GetStartedAside.astro";
---

<section class="site-hero region region-space-xl">
    <div class="site-hero__grid">
        <div class="site-hero__content flow">
            <h1 class="site-hero__title text-pretty">
                Design system rigor, out of the box
            </h1>
            <div class="site-hero__body flow">
                <p>
                    Sugarcube turns design tokens into CSS variables, utilities,
                    and component styles. Change a token, everything updates. Built on the <a
                    href="https://www.designtokens.org/"
                    target="_blank"
                    rel="noopener noreferrer">W3C DTCG token standard</a
                >.</p>
            </div>
        </div>

        <GetStartedAside
            label="Works with Vite or as a standalone CLI"
            primaryHref="/docs/getting-started"
            primaryLabel="Read the Docs"
            primaryArrow
            secondaryHref="/consulting"
            secondaryLabel="Consulting"
        />
    </div>
</section>
