<section
    class="studio-playground region region-space-xl"
    id="playground"
    aria-labelledby="playground-heading"
>
    <div
        class="wrapper"
        style="--wrapper-max-width: var(--container-7xl)"
    >
        <div class="studio-playground__layout">
            <div class="studio-playground__main flow">
                <div class="studio-playground__intro flow">
                    <h2
                        id="playground-heading"
                        class="studio-playground__title text-pretty"
                    >
                        Change one token, everything updates
                    </h2>
                    <p class="studio-playground__lede">
                        Tokens compile to CSS variables, utility classes and
                        component styles. Change a value and every surface built
                        on it updates. The diff is your token files.
                    </p>
                </div>

                <div
                    class="studio-playground__browser"
                    aria-label="Component preview"
                >
                    <div class="studio-playground__browser-chrome">
                        <div
                            class="studio-playground__browser-controls"
                            aria-hidden="true"
                        >
                            <span></span>
                            <span></span>
                            <span></span>
                        </div>
                    </div>
                    <div class="studio-playground__browser-content"></div>
                </div>
            </div>

            <aside
                class="studio-playground__panel-placeholder flow"
                aria-label="Studio panel placeholder"
            >
                <p class="text-quiet">Studio panel</p>
                <p>Client to wire in.</p>
            </aside>
        </div>
    </div>
</section>
