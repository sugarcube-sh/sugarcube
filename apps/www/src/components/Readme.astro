---
import Acknowledgments from "@/src/components/Acknowledgments.astro";
import CTA from "@/src/components/CTA.astro";
import Features from "@/src/components/Features.astro";
import Hero from "@/src/components/Hero.astro";
import Playground from "@/src/components/Playground.astro";
---

<div class="homepage">
    <section class="homepage-section homepage-section--hero" id="hero">
        <div class="wrapper homepage-content readme">
            <Hero />
        </div>
    </section>

    <Playground />

    <section class="homepage-section homepage-section--features" id="features">
        <div class="wrapper homepage-content readme">
            <Features />
        </div>
    </section>

    <CTA />

    <section
        class="homepage-section homepage-section--acknowledgements"
        id="acknowledgements"
    >
        <div class="wrapper homepage-content readme">
            <Acknowledgments />
        </div>
    </section>
</div>
