---
import Logo from "@/src/assets/sugarcube-logo.svg";
import { ArrowRight } from "@lucide/astro";
---

<footer class="site-footer region py-lg mt-xl">
    <div class="repel">
        <div class="flow">
            <div class="cluster">
                <Logo />
                <p>MIT LICENSE © {new Date().getFullYear()}</p>
            </div>
            <nav>
                <ul class="cluster" role="list">
                    <li>
                        <a href="/docs">Docs</a>
                    </li>
                    <li>
                        <a href="/blog">Blog</a>
                    </li>
                    <li>
                        <a href="https://marktomlinson.dev/hire-me">Consulting</a>
                    </li>
                    <li>
                        <a href="https://github.com/sponsors/mark-tomlinson-dev">Sponsor</a>
                    </li>
                    <li>
                        <a href="https://github.com/sugarcube-sh/sugarcube">GitHub</a>
                    </li>
                    <li>
                        <a href="https://bsky.app/profile/sugarcube.sh">Bluesky</a>
                    </li>
                </ul>
            </nav>
        </div>
        <div class="footer-ctas cluster">
            <div class="footer-cta">
                <p>Need a hand with your design system?</p>
                <a href="https://marktomlinson.dev/hire-me" class="site-button is-pill">
                    Let's Talk <ArrowRight />
                </a>
            </div>
        </div>
    </div>
</footer>
